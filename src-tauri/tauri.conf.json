{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WuwaTappo",
  "version": "1.0.1",
  "identifier": "com.kuro.wuwatappo.cn",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "WuwaTappo",
        "url": "index.html",
        "width": 320,
        "height": 420,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "alwaysOnBottom": false,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "center": false,
        "visible": true,
        "focus": false,
        "additionalBrowserArgs": ""
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}